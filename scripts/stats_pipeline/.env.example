# Copy this file to scripts/stats_pipeline/.env and fill in real values.
# .env itself is gitignored - never commit real credentials/ARNs here.

# AWS profile with the least-privilege bdor-stats-pipeline-script IAM user's
# credentials configured (see scripts/stats_pipeline/README.md).
AWS_PROFILE=bdor-stats-script
AWS_REGION=us-east-1

# The stats bucket (infra/template.yaml's StatsBucketName output).
S3_BUCKET=bdor-stats-dev

# infra/template.yaml's AlertTopic ARN (TopicName: bdor-stats-pipeline-alerts-${Stage}).
# Update this if the stack is ever redeployed under a different Stage/account/region.
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:741448927703:bdor-stats-pipeline-alerts-dev

# Copy this value from the repo root's .env (STATS_URL) - there is no shared
# config linking the two files, so keep them in sync by hand if it ever changes.
STATS_URL=

# How many days between fetches. This script's cron job is the only thing that
# schedules fetches now - the EventBridge rate(2 days) schedule that used to
# trigger the Lambda pipeline is gone. This sets the normal cadence; use
# PIPELINE_PAUSED below to stop fetching, not a large value here.
FETCH_INTERVAL_DAYS=2

# Temporary off switch. When set, every cron tick logs "Paused" and exits
# before touching AWS - the cron job itself stays installed. Accepts
# 1/true/yes/on to pause and 0/false/no/off (or absent) to resume; an
# unrecognized value logs a warning and does NOT pause, so a typo can't
# silently freeze the rankings. On resume the next tick fetches immediately,
# since the cadence interval will have elapsed during the pause.
PIPELINE_PAUSED=false

LOCK_FILE=/tmp/bdor-stats-pipeline.lock
LOG_FILE=logs/stats_pipeline.log
